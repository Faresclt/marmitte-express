// firestore.rules v5 — Appareils du resto enregistrés (staff) — 2026-11-18
//
// Problème v4 : l'auth anonyme est ouverte à tous (clé API publique, repo public,
// pas d'App Check) → `isAuth()` ne protégeait rien : n'importe quel visiteur du
// QR pouvait modifier le menu, supprimer les tables, lire les ventes.
//
// v5 : un appareil du resto (caisse, cuisine, téléphones serveuses) s'enregistre
// UNE FOIS avec un code secret (security/enroll, illisible) → doc staff/{uid}.
// `isStaff()` = cet appareil est enregistré.
//
// Transition sans coupure : tant que security/policy.enforce != true, tout
// appareil authentifié garde l'accès « équipe » (comportement v4). Quand les 4
// appareils sont enregistrés, la caisse active la protection (Admin → Sécurité).
//
// Public sans enregistrement : lecture du menu/plan/images, lecture d'UN ticket
// par son id, création d'une commande client au format validé.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════ HELPERS ════════════
    function isAuth() {
      return request.auth != null;
    }
    function isStaff() {
      return isAuth()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }
    function policyPath() {
      return /databases/$(database)/documents/security/policy;
    }
    function enforced() {
      return exists(policyPath()) && get(policyPath()).data.get('enforce', false) == true;
    }
    // Équipe = appareil enregistré, ou tout appareil authentifié tant que la
    // protection n'est pas activée (phase de transition).
    function isTeam() {
      return isStaff() || (isAuth() && !enforced());
    }
    function isStr(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    // ════════════ APPAREILS DU RESTO ════════════
    match /staff/{uid} {
      allow get: if isAuth() && (request.auth.uid == uid || isStaff());
      allow list: if isStaff();
      // Enregistrement : uniquement pour soi-même, avec le bon code.
      allow create: if isAuth()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'label', 'page', 'ua', 'enrolledAt'])
        && request.resource.data.code is string
        && exists(/databases/$(database)/documents/security/enroll)
        && request.resource.data.code == get(/databases/$(database)/documents/security/enroll).data.code
        && isStr(request.resource.data.get('label', ''), 40)
        && isStr(request.resource.data.get('page', ''), 20)
        && isStr(request.resource.data.get('ua', ''), 300);
      allow update: if false;
      // Révocation d'un appareil depuis la caisse (ou par l'appareil lui-même).
      allow delete: if isStaff();
    }

    match /security/policy {
      allow read: if true;
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['enforce', 'updatedAt', 'by'])
        && request.resource.data.enforce is bool;
      allow delete: if false;
    }
    match /security/enroll {
      allow read: if false;
      // Rotation du code depuis la caisse (sans jamais pouvoir le relire).
      allow update: if isStaff()
        && request.resource.data.keys().hasOnly(['code', 'updatedAt'])
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 8;
      allow create, delete: if false;
    }
    match /security/{other} {
      allow read, write: if false;
    }

    // ════════════ CONFIG ════════════
    match /config/{docId} {
      // Public : menu (carte QR), plan de salle, vignettes.
      allow read: if docId == 'menu'
                  || docId == 'tables'
                  || docId.matches('images_.*')
                  || (docId != 'apikeys' && isTeam());
      // apikeys : collection morte, totalement fermée.
      allow write: if docId != 'apikeys' && isTeam();
    }

    // ════════════ SERVICE ════════════
    match /tables/{id} {
      allow read, write: if isTeam();
    }

    match /orders/{id} {
      allow read, update, delete: if isTeam();
      // Commande client (QR) : format strict. Les prix envoyés sont ignorés
      // par la caisse (recalculés depuis le menu) — voir importOrder.
      allow create: if isTeam() || (
        isAuth()
        && request.resource.data.keys().hasOnly(['tableId', 'tableNum', 'items', 'note', 'status', 'source', 'sentAt', 'clientUid'])
        && request.resource.data.source == 'client'
        && request.resource.data.status == 'pending'
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 40
        && isStr(request.resource.data.get('note', ''), 500)
        && isStr(request.resource.data.tableId, 40)
      );
    }

    match /payments/{id} {
      allow read, write: if isTeam();
    }

    // ════════════ ARGENT — inaltérable ════════════
    // Une vente = un document, créé une fois, jamais modifié ni supprimé.
    // Une annulation = un document séparé dans cancel/ (même clé que la vente).
    match /sales/{day} {
      allow read: if isTeam();
      allow write: if false;
      match /v/{saleKey} {
        allow read: if isTeam();
        allow create: if isTeam()
          && request.resource.data.ts is int
          && request.resource.data.total is number
          && request.resource.data.payType is string
          && request.resource.data.hash is string;
        allow update, delete: if false;
      }
      match /cancel/{saleKey} {
        allow read: if isTeam();
        allow create: if isTeam() && request.resource.data.ts is int;
        allow update, delete: if false;
      }
    }

    // Clôtures Z : inaltérables.
    match /closures/{id} {
      allow read, create: if isTeam();
      allow update, delete: if false;
    }

    // Compteur de notes (numérotation continue entre appareils).
    match /counters/{id} {
      allow read, write: if isTeam();
    }

    // Sauvegardes complètes de la caisse (1 doc par jour, sans PIN).
    match /backups/{id} {
      allow read, write: if isTeam();
    }

    // Tickets clients (lien QR) : lecture d'UN ticket par son id, pas de listing.
    match /tickets/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isTeam();
    }

    // ════════════ MULTI-TENANT (inactif, inchangé) ════════════
    function isResto(slug) {
      return isAuth()
        && exists(/databases/$(database)/documents/restaurants/$(slug)/users/$(request.auth.uid));
    }
    function isAdmin(slug) {
      return isResto(slug)
        && get(/databases/$(database)/documents/restaurants/$(slug)/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /restaurants/{slug} {
      allow read: if isResto(slug);
      allow write: if isAdmin(slug);
      match /{document=**} {
        allow read, write: if isAdmin(slug);
      }
    }

    // Tout le reste bloqué
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
