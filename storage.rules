rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Whitelist stricte des types raster (exclut image/svg+xml qui peut
    // embarquer du JavaScript et déclencher du XSS si servi cross-origin).
    function isRasterImage() {
      return request.resource.contentType.matches('image/(png|jpe?g|webp|gif|avif|heic|heif)');
    }
    function isAuth() {
      return request.auth != null;
    }
    // v3 (2026-11-18) : mêmes règles « équipe » que Firestore — appareil du
    // resto enregistré (staff/{uid}), ou tout appareil authentifié tant que la
    // protection n'est pas activée (security/policy.enforce).
    function isStaff() {
      return isAuth()
        && firestore.exists(/databases/(default)/documents/staff/$(request.auth.uid));
    }
    function enforced() {
      return firestore.exists(/databases/(default)/documents/security/policy)
        && firestore.get(/databases/(default)/documents/security/policy).data.get('enforce', false) == true;
    }
    function isTeam() {
      return isStaff() || (isAuth() && !enforced());
    }

    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if isTeam()
                   && request.resource.size < 5 * 1024 * 1024
                   && isRasterImage();
    }

    match /branding/{allPaths=**} {
      allow read: if true;
      allow write: if isTeam()
                   && request.resource.size < 2 * 1024 * 1024
                   && isRasterImage();
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isTeam()
                   && request.resource.size < 5 * 1024 * 1024
                   && isRasterImage();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
